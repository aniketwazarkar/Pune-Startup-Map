MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# Local testing: point MONGODB_URI at a local server instead, e.g.
#   MONGODB_URI=mongodb://127.0.0.1:27017/stagdump
# Then set DUMP_SOURCE_URI to the prod/source cluster and run `npm run dump`
# (writes seed/dump.json) followed by `npm run seed` (loads it into MONGODB_URI).
DUMP_SOURCE_URI=
LOGO_DEV_TOKEN=pk_xxxxxxxxxxxxxxxxxxxxxx
ADMIN_TOKEN=change_me_to_a_long_random_string
ADMIN_USERNAME=change_me
ADMIN_PASSWORD=change_me_too
PORT=4000
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development
