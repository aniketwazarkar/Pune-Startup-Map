MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# Local testing:
#   1. point MONGODB_URI at a local server, e.g.
#        MONGODB_URI=mongodb://127.0.0.1:27017/stagdump
#   2. set DUMP_SOURCE_URI to the prod/source cluster
#   3. `npm run dump`  -> reads source, writes seed/dump.json (read-only on source)
#   4. `npm run seed`  -> wipes MONGODB_URI and loads seed/dump.json
# seed/dump.json is gitignored and is the only seed source (no committed fallback).
DUMP_SOURCE_URI=
LOGO_DEV_TOKEN=pk_xxxxxxxxxxxxxxxxxxxxxx
ADMIN_TOKEN=change_me_to_a_long_random_string
ADMIN_USERNAME=change_me
ADMIN_PASSWORD=change_me_too
PORT=4000
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development
